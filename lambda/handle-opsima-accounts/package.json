{
  "name": "handle-opsima-accounts",
  "version": "11.0.1",
  "private": true,
  "description": "Lambda function deployed in the customer's Management Account to create and transfer Opsima dedicated accounts",
  "license": "Apache-2.0",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "bash scripts/package.sh"
  },
  "dependencies": {
    "@aws-sdk/client-organizations": "^3.600.0",
    "@aws-sdk/client-sts": "^3.600.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.27",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.9",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.71.0"
  }
}
